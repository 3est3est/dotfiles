
{
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.guides.bracketPairs": true,
  "explorer.compactFolders": false,
  "editor.fontLigatures": true,
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Iosevka', 'Menlo', Consolas, Courier New, spacemono",
  "editor.fontWeight": "normal",
  "editor.minimap.autohide": "mouseover",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.stickyScroll.enabled": false,
  "editor.overtypeCursorStyle": "line",
  "terminal.integrated.fontFamily": " 'JetBrainsMono Nerd Font'",
  "terminal.integrated.stickyScroll.enabled": false,
  "git.autofetch": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.editor.empty.hint": "hidden",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false,
  },
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true,
  },
  "workbench.startupEditor": "none",
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "files.autoSave": "afterDelay",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "catppuccin.italicKeywords": false,
  "catppuccin.accentColor": "teal",
  "catppuccin.bracketMode": "dimmed",
  "editor.inlayHints.enabled": "on",

  "editor.semanticHighlighting.enabled": "configuredByTheme",
  "remote.autoForwardPortsSource": "hybrid",
  "prettier.printWidth": 140,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  },
  "workbench.browser.searchEngine": "duckduckgo",
  "workbench.browser.openLocalhostLinks": false,
  "chat.mcp.gallery.enabled": true,
  "terminal.integrated.cursorBlinking": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "fluent-icons",
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
  "terminal.integrated.commandsToSkipShell": [
    "kilo-code.new.agentManagerOpen",
    "kilo-code.new.agentManager.showTerminal",
    "kilo-code.new.agentManager.previousTerminal",
    "kilo-code.new.agentManager.nextTerminal"
  ],
  "workbench.browser.showInTitleBar": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "notebook.output.scrolling": true,
  "window.zoomLevel": 1,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "editor.smoothScrolling": true,
  "workbench.list.horizontalScrolling": true,
  "workbench.colorTheme": "Fleet Dark",
  "terminal.integrated.tabs.defaultIcon": "console",
  "terminal.external.linuxExec": "kitty",
  "window.commandCenter": false,
  "window.menuBarVisibility": "compact",
  "window.menuStyle": "native",
  "window.customTitleBarVisibility": "never",
  "window.titleBarStyle": "native",
}
