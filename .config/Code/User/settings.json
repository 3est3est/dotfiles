{
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.guides.bracketPairs": true,
  "window.titleBarStyle": "custom",
  "explorer.compactFolders": false,
  "editor.fontLigatures": false,
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Iosevka', 'Menlo', Consolas, Courier New, spacemono",
  "editor.fontWeight": "normal",
  "editor.minimap.autohide": "mouseover",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.stickyScroll.enabled": false,
  "editor.overtypeCursorStyle": "line",
  "terminal.integrated.fontFamily": " 'JetBrainsMono Nerd Font'",
  "terminal.integrated.stickyScroll.enabled": false,
  "git.autofetch": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.editor.empty.hint": "hidden",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false,
  },
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true,
  },
  "workbench.startupEditor": "none",
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "files.autoSave": "afterDelay",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "window.menuBarVisibility": "visible",
  "catppuccin.italicKeywords": false,
  "catppuccin.accentColor": "teal",
  "catppuccin.bracketMode": "dimmed",
  "editor.inlayHints.enabled": "on",

  "editor.semanticHighlighting.enabled": "configuredByTheme",
  "remote.autoForwardPortsSource": "hybrid",
  "prettier.printWidth": 140,
  "claudeCode.preferredLocation": "panel",
  "editor.fontSize": 15,
  "workbench.iconTheme": "material-icon-theme",
  "terminal.integrated.cursorStyle": "block",
  "antigravity.marketplaceGalleryItemURL": "https://marketplace.visualstudio.com/item",
  "antigravity.marketplaceExtensionGalleryServiceURL": "https://marketplace.visualstudio.com/_apis/public/gallery",
  "editor.smoothScrolling": true,
  "workbench.colorTheme": "Fleet Dark",
}
