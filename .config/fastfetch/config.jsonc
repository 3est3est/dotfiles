{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "nixos_small",
    "type": "auto",
    "padding": {
      "top": 1,
      "right": 3,
      "left": 2
    },
    "color": {
      "1": "green",
      "2": "cyan"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "blue",
      "title": "cyan",
      "separator": "blue"
    }
  },
  "modules": [
    {
      "key": "{#title}",
      "type": "title",
      "format": "{#title}{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "{#title} ----------------------"
    },
    {
      "key": " {#keys} OS      ",
      "type": "os",
      "format": "{2}"
    },
    {
      "key": " {#keys} Host    ",
      "type": "host"
    },
    {
      "key": " {#keys} Kernel  ",
      "type": "kernel"
    },
    {
      "key": " {#keys} Pkgs    ",
      "type": "packages",
      "format": "{pacman} (pacman) {flatpak-all} (flatpak)"
    },
    {
      "key": " {#keys} WM      ",
      "type": "wm"
    },
    {
      "key": " {#keys} CPU     ",
      "type": "cpu",
      "format": "{1}"
    },
    {
      "key": " {#keys} Term    ",
      "type": "terminal"
    },
    {
      "key": " {#keys} Shell   ",
      "type": "shell"
    },
    {
      "key": " {#keys} Memory  ",
      "type": "memory"
    },
    {
      "key": " {#keys} Uptime  ",
      "type": "uptime"
    },
    {
      "key": " {#32} 󰮯 {#37}•••   ",
      "type": "custom",
      "format": "{#30}󰊠 {#37}󰊠 {#36}󰊠 {#35}󰊠 {#34}󰊠 {#33}󰊠 {#32}󰊠 {#31}󰊠 "
    },
    {
      "type": "text",
      "text": " "
    }
  ]
}
