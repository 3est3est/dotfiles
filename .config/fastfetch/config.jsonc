{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "cachyos_small",
    "type": "auto",
    "padding": {
      "top": 0,
      "right": 3,
      "left": 2
    },
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": 1,
      "title": 2,
    }
  },
  "modules": [
    {
      "key": " {#title}",
      "type": "title",
      "format": "{#keys}{user-name}{#39}@{#title}{host-name}"
    },
    {
      "key": " {#title}   ",
      "type": "os",
      "format": "{2}"
    },
    {
      "key": " {#title}   ",
      "type": "kernel"
    },
    {
      "key": " {#title} 󰌢  ",
      "type": "host",
    },
    {
      "key": " {#title} 󰏖  ",
      "type": "packages",
      "format": "{pacman} (pacman), {flatpak-all} (flatpak)"
    },
    {
      "key": " {#title}   ",
      "type": "wm"
    },
    {
      "key": " {#keys}   ",
      "type": "terminal"
    },
    {
      "key": " {#keys} 󰞷  ",
      "type": "shell"
    },
    {
      "key": " {#keys}   ",
      "type": "cpu",
      "format": "{1}"
    },    
    {
      "key": " {#keys}   ",
      "type": "memory"
    },
    {
      "key": " {#keys}   ",
      "type": "uptime"
    },
    {
      "key": " {#33} 󰮯 {#37}•",
      "type": "custom",
      "format": "{#38}󰊠 {#37}󰊠 {#35}󰊠 {#36}󰊠 {#34}󰊠 {#33}󰊠 {#32}󰊠 {#31}󰊠 "
    },
    {
      "type": "text",
      "text": " "
    }
  ]
}
