{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        //"source": "~/Pictures/Logo/ascii-art.txt",
        "type": "small",
        "padding": {
            "top": 0,
            "right": 3,
            "left": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": " {#37}{#keys}",
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "key": " {#31} distro  ",
            "type": "os",
            "format": "{2}"
        },
        {
            "key": " {#32} host    ",
            "type": "host"
        },
        {
            "key": " {#33} kernel  ",
            "type": "kernel"
        },
        {
            "key": " {#34} pkgs    ",
            "type": "packages",
            "format": "{pacman} (pacman) {flatpak-all} (flatpak)"
        },
        {
            "key": " {#35} wm      ",
            "type": "wm"
        },
        {
            "key": " {#36} cpu     ",
            "type": "cpu",
            "format": "{1}"
        },
        {
            "key": " {#31} term    ",
            "type": "terminal"
        },
        {
            "key": " {#32} shell   ",
            "type": "shell"
        },
        {
            "key": " {#33} memory  ",
            "type": "memory"
        },
        {
            "key": " {#34} uptime  ",
            "type": "uptime"
        },
        {
            "key": " {#37} 󰮯 •••   ",
            "type": "custom",
            "format": "{#30}󰊠 {#37}󰊠 {#36}󰊠 {#35}󰊠 {#34}󰊠 {#33}󰊠 {#32}󰊠 {#31}󰊠 "
        },
        {
            "type": "text",
            "text": " "
        },
    ]
}

