{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        //"source": "~/Pictures/Logo/ascii-art.txt",
        "type": "small",
        "padding": {
            "top": 0,
            "right": 3,
            "left": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": " {#keys}",
            "type": "title",
            "format": "{#32}{user-name}{#37}@{#32}{host-name}"
        },
        {
            "key": " {#36} Distro  ",
            "type": "os",
            "format": "{2}"
        },
        {
            "key": " {#36} Host    ",
            "type": "host"
        },
        {
            "key": " {#36} Kernel  ",
            "type": "kernel"
        },
        {
            "key": " {#36} Pkgs    ",
            "type": "packages",
            "format": "{pacman} (pacman) {flatpak-all} (flatpak)"
        },
        {
            "key": " {#36} WM      ",
            "type": "wm"
        },
        {
            "key": " {#36} CPU     ",
            "type": "cpu",
            "format": "{1}"
        },
        {
            "key": " {#36} Term    ",
            "type": "terminal"
        },
        {
            "key": " {#36} Shell   ",
            "type": "shell"
        },
        {
            "key": " {#36} Memory  ",
            "type": "memory"
        },
        {
            "key": " {#36} Uptime  ",
            "type": "uptime"
        },
        {
            "key": " {#33} 󰮯 {#37}•••   ",
            "type": "custom",
            "format": "{#30}󰊠 {#37}󰊠 {#36}󰊠 {#35}󰊠 {#34}󰊠 {#33}󰊠 {#32}󰊠 {#31}󰊠 "
        },
        {
            "type": "text",
            "text": " "
        },
    ]
}

