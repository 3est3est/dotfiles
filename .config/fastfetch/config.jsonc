{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "type": "auto",
    "padding": {
      "top": 1,
      "right": 3,
      "left": 2
    },
    "color": {
      "1": "36",
      "2": "36"
    },
  },
  "display": {
  "separator": " ",
  },
  "modules": [
    {
      "key": " {#title}",
      "type": "title",
      "format": "{#35}{user-name}{#97}@{#36}{host-name}"
    },
    {
      "key": " {#34} 󰣇  ",
      "type": "os",
      "format": "{2}"
    },
    {
      "key": " {#36}   ",
      "type": "kernel"
    },
    {
      "key": " {#96} 󰌢  ",
      "type": "host",
    },
    {
      "key": " {#33} 󰏖  ",
      "type": "packages",
      "format": "{pacman} (pacman), {flatpak-all} (flatpak)"
    },
    {
      "key": " {#91}   ",
      "type": "wm"
    },
    {
      "key": " {#35}   ",
      "type": "terminal"
    },
    {
      "key": " {#34} 󰞷  ",
      "type": "shell"
    },
    {
      "key": " {#36}   ",      
      "type": "cpu",
      "format": "{1}"
    },    
    {
      "key": " {#96}   ",
      "type": "memory"
    },
    {
      "key": " {#92}   ",
      "type": "uptime"
    },
    {
      "key": " {#93} 󰮯 {#97}•",
      "type": "custom",
      "format": "{#30}󰊠 {#37}󰊠 {#35}󰊠 {#36}󰊠 {#34}󰊠 {#33}󰊠 {#32}󰊠 {#31}󰊠 "
    },
    {
      "type": "text",
      "text": " "
    }
  ]
}
