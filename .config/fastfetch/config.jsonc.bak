{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        //"source": "~/Pictures/Logo/ascii-art.txt",
        "type": "small",
        "padding": {
            "top": 1,
            "right": 3,
            "left": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "{#37}╭───────────╮{#}",
            "type": "custom"
        },
        {
            "key": "{#37}│{#} {#31} user    {#keys}{#37}│{#}",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "{#37}│{#} {#32}{icon} distro  {#keys}{#37}│{#}",
            "type": "os",
            "format": "{2}"
        },
        {
            "key": "{#37}│{#} {#33} kernel  {#keys}{#37}│{#}",
            "type": "kernel",
            //"format": "{2}"
        },
        {
            "key": "{#37}│{#} {#34} pkgs    {#keys}{#37}│{#}",
            "type": "packages",
            "format": "{pacman} (pacman) {flatpak-all} (flatpak)"
        },
        {
            "key": "{#37}│{#} {#35} wm      {#keys}{#37}│{#}",
            "type": "wm"
        },
        {
            "key": "{#37}│{#} {#36}󰍛 cpu     {#keys}{#37}│{#}",
            "type": "cpu",
            "format": "{1}"
        },
        {
            "key": "{#37}│{#} {#31} term    {#keys}{#37}│{#}",
            "type": "terminal"
        },
        {
            "key": "{#37}│{#} {#32}  shell  {#keys}{#37}│{#}",
            "type": "shell"
        },
        {
            "key": "{#37}│{#} {#33} memory  {#keys}{#37}│{#}",
            "type": "memory"
        },
        {
            "key": "{#37}│{#} {#34}󰅐 uptime  {#keys}{#37}│{#}",
            "type": "uptime"
        },
        {
            "key": "{#37}├───────────┤{#}",
            "type": "custom"
        },
        {
            "key": "{#37}│{#}{#37} 󰮯 •••••    {#keys}{#37}│{#}",
            "type": "custom",
            "format": "{#30}󰊠 {#37}󰊠 {#36}󰊠 {#35}󰊠 {#34}󰊠 {#33}󰊠 {#32}󰊠 {#31}󰊠 "
            //"symbol": "circle"
        },
        {
            "key": "{#37}╰───────────╯{#}",
            "type": "custom"
        }
    ]
}

