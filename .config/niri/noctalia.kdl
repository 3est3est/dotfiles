layout {

    focus-ring {
        active-color   "#c2c5da"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c2c5da"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c2c5da"
        inactive-color "#2f3343"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c2c5da80"
    }
}

recent-windows {
    highlight {
        active-color "#c2c5da"
        urgent-color "#ffb4ab"
    }
}
