// Noctalia-specific config (moved from config.kdl)
// Note: noctalia.kdl is auto-generated by Noctalia (appearance) — edit here instead.

// Noctalia
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

/*
  Noctalia
  Disable xray on all our surfaces so it looks more realistic.
  Noctalia publishes blur regions automatically when ext-background-effects is available.
*/
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
    //blur true
  }
}

/* Disable blur ONLY on Noctalia bar. */
layer-rule {
  match namespace="^noctalia-bar-[^\"]+$"

  background-effect {
      blur false
      xray false
  }
}

/* Enable blur on noctalia's window switcher and disable xray. */
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

//Place Noctalia's blurred backdrop in niri's overview
layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

binds {
  
   // noctalia launcher
   Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    
   // pugins
    Mod+F1 {spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }

    // Core Noctalia binds
    Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+SHIFT+S { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher";}

    // Audio & Brightness
    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }

    Mod+D { spawn-sh "noctalia msg dock-toggle"; }
    Mod+Alt+L hotkey-overlay-title="Lock the Screen: noctalia" { spawn-sh "noctalia msg session lock"; }
    Ctrl+Mod+Alt+R { spawn-sh "noctalia msg config-reload"; }
    Mod+Shift+C { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Shift+W { spawn-sh "noctalia msg panel-toggle wallpaper"; }

    Print { spawn-sh "noctalia msg screenshot-region"; }
    Ctrl+Print { spawn-sh "noctalia msg screenshot-fullscreen"; }

    Ctrl+Alt+Delete { spawn-sh "noctalia msg panel-toggle session"; }
}
